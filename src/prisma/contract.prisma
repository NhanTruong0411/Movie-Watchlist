// use prisma-8

model User {
  id String @id @default(uuid())
  name String?
  email String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAtString()
}

model Movie {
  id String @id @default(uuid())
  title String
  overview String?
  releaseYear Int
  genre String[] @default([])
  runtime Int
  posterUrl String?
  createBy String
  createdAt DateTime @default(now())
  
  updatedAt temporal.updatedAtString()
  creator User @relation("MovieCreator", fields: [createBy], references: [id])
  watchlistItems WatchlistItem[] 
}

model WatchlistItem {
  id String @id @default(uuid())
  userId String
  movieId String
  status WatchlistItemStatus @default(PLANNED)
  rating Int?
  notes String?
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAtString()

  // relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

enum WatchlistItemStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}
